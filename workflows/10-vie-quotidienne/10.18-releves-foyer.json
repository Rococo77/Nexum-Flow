{
  "name": "10.18 – Relevés du foyer & tendance conso",
  "nodes": [
    {
      "id": "d1d2d3d4-1018-1018-1018-000000000001",
      "name": "Webhook Relevé",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        150
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "releve",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1018-1018-1018-000000000002",
      "name": "Valider le relevé",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        150
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $input.item.json.body || $input.item.json;\nconst types = ['electricite', 'eau', 'gaz', 'km_voiture'];\nconst type = String(b.type || '').trim();\nif (!types.includes(type)) throw new Error('type invalide (electricite|eau|gaz|km_voiture)');\nconst valeur = Number(b.valeur);\nif (isNaN(valeur) || valeur < 0) throw new Error('valeur numérique requise');\nconst unites = { electricite: 'kWh', eau: 'm3', gaz: 'kWh', km_voiture: 'km' };\nreturn { type, valeur, unite: String(b.unite || unites[type]).substring(0, 20) };"
      }
    },
    {
      "id": "d1d2d3d4-1018-1018-1018-000000000003",
      "name": "Enregistrer le relevé",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        750,
        150
      ],
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "releves_foyer"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "type": "={{ $json.type }}",
            "valeur": "={{ $json.valeur }}",
            "unite": "={{ $json.unite }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": true,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1018-1018-1018-000000000004",
      "name": "Réponse webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1000,
        150
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, type: $('Valider le relevé').item.json.type, valeur: $('Valider le relevé').item.json.valeur }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "d1d2d3d4-1018-1018-1018-000000000005",
      "name": "Le 3 du mois à 19h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        450
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 19 3 * *"
            }
          ]
        }
      }
    },
    {
      "id": "d1d2d3d4-1018-1018-1018-000000000006",
      "name": "Consommation par mois",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        450
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT type, unite, date_trunc('month', created_at)::date AS mois,\n       SUM(valeur)::float AS total\nFROM releves_foyer\nWHERE created_at >= CURRENT_DATE - INTERVAL '4 months'\nGROUP BY type, unite, 3\nORDER BY type, mois",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1018-1018-1018-000000000007",
      "name": "Comparer les mois",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        450
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(j => j.type);\nif (!rows.length) return [];\nconst parType = {};\nfor (const r of rows) {\n  (parType[r.type] = parType[r.type] || { unite: r.unite, mois: [] }).mois.push(r);\n}\nconst lignes = Object.entries(parType).map(([type, d]) => {\n  const m = d.mois;\n  const dernier = m[m.length - 1];\n  const precedent = m.length > 1 ? m[m.length - 2] : null;\n  const variation = precedent && precedent.total > 0\n    ? Math.round(((dernier.total - precedent.total) / precedent.total) * 100) : null;\n  return `${type} : ${dernier.total} ${d.unite}` +\n    (variation != null ? ` (${variation >= 0 ? '+' : ''}${variation}% vs mois précédent)` : '');\n});\nreturn [{ json: { lignes: lignes.join('\\n') } }];"
      }
    },
    {
      "id": "d1d2d3d4-1018-1018-1018-000000000008",
      "name": "Conseils conso (IA)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1000,
        450
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "mistral-large-latest"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es un conseiller en sobriété énergétique bienveillant. À partir des consommations mensuelles du foyer (électricité, eau, gaz, kilomètres voiture) et de leurs variations, rédige en HTML léger : un bilan d'une phrase par poste, puis 3 conseils concrets et adaptés à la saison pour réduire la facture et l'empreinte carbone. Pas de moralisation."
            },
            {
              "role": "user",
              "content": "Consommations du foyer :\n{{ $json.lignes }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 700
        }
      }
    },
    {
      "id": "d1d2d3d4-1018-1018-1018-000000000009",
      "name": "Email bilan foyer",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1250,
        450
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $env.EMAIL_PERSO }}",
        "subject": "🏠 Bilan consommations du foyer",
        "emailType": "html",
        "message": "<html><body><h2>🏠 Vos consommations</h2><pre>{{ $(\"Comparer les mois\").item.json.lignes }}</pre>{{ $json.message.content }}</body></html>"
      }
    }
  ],
  "connections": {
    "Webhook Relevé": {
      "main": [
        [

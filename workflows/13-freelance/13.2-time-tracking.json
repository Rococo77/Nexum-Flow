{
  "name": "13.2 – Time-tracking passif par projet",
  "nodes": [
    {
      "id": "d1d2d3d4-1302-1302-1302-000000000001",
      "name": "Webhook Activité projet",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        150
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "activite-projet",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1302-1302-1302-000000000002",
      "name": "Valider l’activité",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        150
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $input.item.json.body || $input.item.json;\nconst projet = String(b.projet || '').trim().substring(0, 255);\nif (!projet) throw new Error('projet requis');\nconst duree = Number(b.duree_minutes);\nreturn {\n  projet,\n  source: String(b.source || 'manuel').substring(0, 100),\n  description: String(b.description || '').substring(0, 500),\n  duree_minutes: !isNaN(duree) && duree > 0 ? Math.min(duree, 720) : 30\n};"
      }
    },
    {
      "id": "d1d2d3d4-1302-1302-1302-000000000003",
      "name": "Enregistrer l’activité",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        750,
        150
      ],
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "activites_projets"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "projet": "={{ $json.projet }}",
            "source": "={{ $json.source }}",
            "description": "={{ $json.description }}",
            "duree_minutes": "={{ $json.duree_minutes }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": true,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1302-1302-1302-000000000004",
      "name": "Réponse webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1000,
        150
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, projet: $('Valider l’activité').item.json.projet }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "d1d2d3d4-1302-1302-1302-000000000005",
      "name": "Vendredi 17h30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        450
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 17 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "d1d2d3d4-1302-1302-1302-000000000006",
      "name": "Temps de la semaine",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        450
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.projet, COUNT(*)::int AS nb_activites,\n       ROUND(SUM(a.duree_minutes) / 60.0, 1)::float AS heures,\n       (SELECT d.montant_ht FROM devis d\n          JOIN clients c ON c.id = d.client_id\n          WHERE d.statut IN ('accepte', 'envoye')\n            AND (c.entreprise ILIKE '%' || a.projet || '%' OR d.notes ILIKE '%' || a.projet || '%')\n          ORDER BY d.created_at DESC LIMIT 1)::float AS budget_devis\nFROM activites_projets a\nWHERE a.created_at >= date_trunc('week', CURRENT_DATE)\nGROUP BY a.projet\nORDER BY heures DESC",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1302-1302-1302-000000000007",
      "name": "Préparer le bilan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        450
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(j => j.projet);\nif (!rows.length) return [];\nconst lignes = rows.map(r => `- ${r.projet} : ${r.heures} h (${r.nb_activites} activités)` +\n  (r.budget_devis ? ` – devis lié : ${r.budget_devis} € HT` : ''));\nconst totalHeures = rows.reduce((s, r) => s + r.heures, 0);\nreturn [{ json: { lignes: lignes.join('\\n'), total: Math.round(totalHeures * 10) / 10 } }];"
      }
    },
    {
      "id": "d1d2d3d4-1302-1302-1302-000000000008",
      "name": "Analyse de dérive (IA)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1000,
        450
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "mistral-large-latest"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu analyses la répartition du temps d'un freelance/dirigeant d'agence sur la semaine. À partir des heures par projet (et du budget devis quand il est connu), identifie : les projets qui consomment le plus, ceux qui risquent de dépasser leur budget (en supposant un taux de 60-80 €/h), et une suggestion de priorisation pour la semaine suivante. 8 lignes max, format tirets."
            },
            {
              "role": "user",
              "content": "Semaine : {{ $json.total }} h au total\n{{ $json.lignes }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 600
        }
      }
    },
    {
      "id": "d1d2d3d4-1302-1302-1302-000000000009",
      "name": "Bilan sur Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1250,
        450
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_GUILD_ID }}"
        },
        "sendTo": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_PROJETS_CHANNEL_ID }}"
        },
        "content": "⏱️ **Temps de la semaine** ({{ $('Préparer le bilan').item.json.total }} h)\n{{ $('Préparer le bilan').item.json.lignes }}\n\n{{ $json.message.content }}",
        "options": {}
      }
    }
  ],
  "connections": {

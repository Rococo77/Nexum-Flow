{
  "name": "10.16 – Garde-manger anti-gaspillage",
  "nodes": [
    {
      "id": "d1d2d3d4-1016-1016-1016-000000000001",
      "name": "Webhook Garde-manger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        150
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "garde-manger",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1016-1016-1016-000000000002",
      "name": "Valider le produit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        150
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $input.item.json.body || $input.item.json;\nconst produit = String(b.produit || '').trim().substring(0, 255);\nconst datePeremption = String(b.date_peremption || '').trim();\nif (!produit) throw new Error('produit requis');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(datePeremption)) throw new Error('date_peremption requise au format YYYY-MM-DD');\nreturn {\n  produit,\n  date_peremption: datePeremption,\n  quantite: String(b.quantite || '1').substring(0, 100)\n};"
      }
    },
    {
      "id": "d1d2d3d4-1016-1016-1016-000000000003",
      "name": "Enregistrer le produit",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        750,
        150
      ],
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "garde_manger"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "produit": "={{ $json.produit }}",
            "date_peremption": "={{ $json.date_peremption }}",
            "quantite": "={{ $json.quantite }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": true,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1016-1016-1016-000000000004",
      "name": "Réponse webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1000,
        150
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, produit: $('Valider le produit').item.json.produit }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "d1d2d3d4-1016-1016-1016-000000000005",
      "name": "Tous les jours 18h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        450
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "d1d2d3d4-1016-1016-1016-000000000006",
      "name": "Produits qui périment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        450
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, produit, quantite, date_peremption,\n       (date_peremption - CURRENT_DATE)::int AS dans_jours\nFROM garde_manger\nWHERE consomme = FALSE AND alerte_envoyee = FALSE\n  AND date_peremption <= CURRENT_DATE + 3\nORDER BY date_peremption",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1016-1016-1016-000000000007",
      "name": "Préparer la liste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        450
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json).filter(j => j.produit);\nif (!items.length) return [];\nreturn [{ json: {\n  produits: items.map(j => `${j.produit} (x${j.quantite}, ${j.dans_jours <= 0 ? 'périmé ou aujourd\\'hui' : 'dans ' + j.dans_jours + ' j'})`),\n  noms: items.map(j => j.produit).join(', ')\n} }];"
      }
    },
    {
      "id": "d1d2d3d4-1016-1016-1016-000000000008",
      "name": "Recette anti-gaspi (IA)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1000,
        450
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "mistral-large-latest"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es un cuisinier pragmatique et anti-gaspillage. On te donne des ingrédients qui périment bientôt. Propose 1 ou 2 recettes simples (moins de 30 min) qui les utilisent en priorité, en HTML léger (titres h3, listes). Indique aussi ce qui peut se congeler tel quel."
            },
            {
              "role": "user",
              "content": "Ingrédients à utiliser vite : {{ $json.noms }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 700
        }
      }
    },
    {
      "id": "d1d2d3d4-1016-1016-1016-000000000009",
      "name": "Email anti-gaspi",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1250,
        450
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $env.EMAIL_PERSO }}",
        "subject": "🥕 À consommer vite : {{ $(\"Préparer la liste\").item.json.produits.length }} produit(s)",
        "emailType": "html",
        "message": "<html><body><h2>🥕 Bientôt périmés</h2><ul>{{ $(\"Préparer la liste\").item.json.produits.map(p => `<li>${p}</li>`).join(\"\") }}</ul>{{ $json.message.content }}</body></html>"
      }
    },
    {
      "id": "d1d2d3d4-1016-1016-1016-000000000010",
      "name": "Marquer comme alerté",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1500,
        450
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE garde_manger SET alerte_envoyee = TRUE\nWHERE consomme = FALSE AND alerte_envoyee = FALSE\n  AND date_peremption <= CURRENT_DATE + 3",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook Garde-manger": {

{
  "name": "12.2 – Healthcheck de la stack",
  "nodes": [
    {
      "id": "c1c2c3c4-1202-1202-1202-000000000001",
      "name": "Toutes les 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "c1c2c3c4-1202-1202-1202-000000000002",
      "name": "Ping FastAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "http://fastapi:8000/health",
        "options": {
          "timeout": 5000
        }
      }
    },
    {
      "id": "c1c2c3c4-1202-1202-1202-000000000003",
      "name": "Ping MinIO",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "http://minio:9000/minio/health/live",
        "options": {
          "timeout": 5000
        }
      }
    },
    {
      "id": "c1c2c3c4-1202-1202-1202-000000000004",
      "name": "Vérifier PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 1 AS ok",
        "options": {}
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "c1c2c3c4-1202-1202-1202-000000000005",
      "name": "Évaluer les services",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const checks = [\n  { service: 'FastAPI', json: $('Ping FastAPI').first().json },\n  { service: 'MinIO', json: $('Ping MinIO').first().json },\n  { service: 'PostgreSQL', json: $('Vérifier PostgreSQL').first().json },\n];\nconst pannes = checks\n  .filter(c => c.json && c.json.error)\n  .map(c => `❌ ${c.service} : ${String(c.json.error.message || c.json.error).substring(0, 200)}`);\nreturn [{ json: { ok: pannes.length === 0, pannes, verifie_le: new Date().toISOString() } }];"
      }
    },
    {
      "id": "c1c2c3c4-1202-1202-1202-000000000006",
      "name": "Panne détectée ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-panne",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "c1c2c3c4-1202-1202-1202-000000000007",
      "name": "Alerter – service en panne",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1750,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_GUILD_ID }}"
        },
        "sendTo": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_ADMIN_CHANNEL_ID }}"
        },
        "content": "🔥 **STACK NEXUM – PANNE DÉTECTÉE**\n{{ $json.pannes.join('\\n') }}\n⏰ {{ $json.verifie_le }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Toutes les 15 minutes": {
      "main": [
        [
          {
            "node": "Ping FastAPI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ping FastAPI": {
      "main": [
        [
          {
            "node": "Ping MinIO",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ping MinIO": {
      "main": [
        [
          {
            "node": "Vérifier PostgreSQL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Vérifier PostgreSQL": {
      "main": [
        [
          {
            "node": "Évaluer les services",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Évaluer les services": {
      "main": [
        [
          {
            "node": "Panne détectée ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Panne détectée ?": {
      "main": [
        [
          {
            "node": "Alerter – service en panne",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "c1c2c3c4-1202-1202-1202-000000000099",
  "meta": {
    "instanceId": "nexum-flow"
  },
  "tags": [
    {
      "id": "tag-ops",
      "name": "ops"
    }
  ]
}
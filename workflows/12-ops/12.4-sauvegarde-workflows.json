{
  "name": "12.4 – Sauvegarde hebdomadaire des workflows",
  "nodes": [
    {
      "id": "c1c2c3c4-1204-1204-1204-000000000001",
      "name": "Dimanche 4h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * 0"
            }
          ]
        }
      }
    },
    {
      "id": "c1c2c3c4-1204-1204-1204-000000000002",
      "name": "Exporter les workflows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://n8n:5678/api/v1/workflows",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "250"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $env.N8N_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "c1c2c3c4-1204-1204-1204-000000000003",
      "name": "Préparer l’archive",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data = $input.first().json.data || [];\nif (!data.length) throw new Error('Aucun workflow retourné par l\\'API n8n');\nconst date = new Date().toISOString().split('T')[0];\nreturn [{ json: {\n  chemin: `Backups/n8n/nexum-workflows-${date}.json`,\n  contenu: JSON.stringify(data),\n  nb_workflows: data.length,\n  date\n} }];"
      }
    },
    {
      "id": "c1c2c3c4-1204-1204-1204-000000000004",
      "name": "Déposer sur MinIO",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.API_HOST }}/api/v1/storage/upload",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chemin: $json.chemin, contenu: $json.contenu }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "c1c2c3c4-1204-1204-1204-000000000005",
      "name": "Confirmer la sauvegarde",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_GUILD_ID }}"
        },
        "sendTo": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_ADMIN_CHANNEL_ID }}"
        },
        "content": "💾 **Sauvegarde n8n effectuée** – {{ $('Préparer l’archive').item.json.nb_workflows }} workflows → `{{ $('Préparer l’archive').item.json.chemin }}`",
        "options": {}
      }
    }
  ],
  "connections": {
    "Dimanche 4h": {
      "main": [
        [
          {
            "node": "Exporter les workflows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Exporter les workflows": {
      "main": [
        [
          {
            "node": "Préparer l’archive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Préparer l’archive": {
      "main": [
        [
          {
            "node": "Déposer sur MinIO",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Déposer sur MinIO": {
      "main": [
        [
          {
            "node": "Confirmer la sauvegarde",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "c1c2c3c4-1204-1204-1204-000000000099",
  "meta": {
    "instanceId": "nexum-flow"
  },
  "tags": [
    {
      "id": "tag-ops",
      "name": "ops"
    }
  ]
}
{
  "name": "10.14 – Suivi des abonnements récurrents",
  "nodes": [
    {
      "id": "d1d2d3d4-1014-1014-1014-000000000001",
      "name": "Le 2 du mois à 8h30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 8 2 * *"
            }
          ]
        }
      }
    },
    {
      "id": "d1d2d3d4-1014-1014-1014-000000000002",
      "name": "Détecter les récurrences",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH mois AS (\n  SELECT LOWER(TRIM(description)) AS libelle, montant,\n         date_trunc('month', date) AS mois\n  FROM depenses\n  WHERE date >= CURRENT_DATE - INTERVAL '4 months' AND description IS NOT NULL\n  GROUP BY 1, 2, 3\n)\nSELECT libelle, montant::float, COUNT(*)::int AS nb_mois,\n       MAX(mois)::date AS dernier_mois\nFROM mois\nGROUP BY libelle, montant\nHAVING COUNT(*) >= 3\nORDER BY montant DESC",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1014-1014-1014-000000000003",
      "name": "Détecter les hausses",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        750,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT LOWER(TRIM(d1.description)) AS libelle,\n       d1.montant::float AS montant_actuel, d2.montant::float AS montant_precedent\nFROM depenses d1\nJOIN depenses d2 ON LOWER(TRIM(d1.description)) = LOWER(TRIM(d2.description))\n  AND date_trunc('month', d2.date) = date_trunc('month', d1.date) - INTERVAL '1 month'\nWHERE date_trunc('month', d1.date) = date_trunc('month', CURRENT_DATE) - INTERVAL '1 month'\n  AND d1.montant > d2.montant\n  AND d1.description IS NOT NULL",
        "options": {}
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "d1d2d3d4-1014-1014-1014-000000000004",
      "name": "Préparer la synthèse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const recurrents = $('Détecter les récurrences').all().map(i => i.json)\n  .filter(r => r.libelle);\nconst hausses = $('Détecter les hausses').all().map(i => i.json)\n  .filter(h => h.libelle && !h.error);\nconst totalMensuel = recurrents.reduce((s, r) => s + (r.montant || 0), 0);\nreturn [{ json: {\n  vide: recurrents.length === 0 && hausses.length === 0,\n  recurrents, hausses,\n  total_mensuel: Math.round(totalMensuel * 100) / 100\n} }];"
      }
    },
    {
      "id": "d1d2d3d4-1014-1014-1014-000000000005",
      "name": "Quelque chose à signaler ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-0005",
              "leftValue": "={{ $json.vide }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "d1d2d3d4-1014-1014-1014-000000000006",
      "name": "Bilan abonnements (IA)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1500,
        200
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "mistral-large-latest"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es un conseiller budget personnel. À partir des dépenses récurrentes détectées (même libellé + même montant sur 3 mois ou plus) et des hausses de prix repérées, rédige un court bilan HTML (sans balises html/body) : liste des abonnements probables avec leur coût mensuel et annuel, hausses à vérifier, et 2-3 suggestions d'économies. Reste factuel, ne suppose rien qui ne soit pas dans les données."
            },
            {
              "role": "user",
              "content": "Récurrences détectées (total ≈ {{ $json.total_mensuel }} €/mois) :\n{{ $json.recurrents.map(r => `- ${r.libelle} : ${r.montant} €/mois (${r.nb_mois} mois)`).join('\\n') || 'aucune' }}\n\nHausses le mois dernier :\n{{ $json.hausses.map(h => `- ${h.libelle} : ${h.montant_precedent} € → ${h.montant_actuel} €`).join('\\n') || 'aucune' }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 800
        }
      }
    },
    {
      "id": "d1d2d3d4-1014-1014-1014-000000000007",
      "name": "Envoyer le bilan",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1750,
        200
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $env.EMAIL_PERSO }}",
        "subject": "💳 Abonnements & prélèvements récurrents – {{ $now.format(\"MM/yyyy\") }}",
        "emailType": "html",
        "message": "<html><body>{{ $json.message.content }}</body></html>"
      }
    }
  ],

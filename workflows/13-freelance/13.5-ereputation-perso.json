{
  "name": "13.5 – Veille e-réputation personnelle",
  "nodes": [
    {
      "id": "d1d2d3d4-1305-1305-1305-000000000001",
      "name": "Jours ouvrés 7h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "d1d2d3d4-1305-1305-1305-000000000002",
      "name": "Mentions Hacker News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://hn.algolia.com/api/v1/search_by_date?query={{ encodeURIComponent($env.MARQUE_PERSO) }}&hitsPerPage=20",
        "options": {
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "d1d2d3d4-1305-1305-1305-000000000003",
      "name": "Mentions Reddit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://www.reddit.com/search.json?q={{ encodeURIComponent($env.MARQUE_PERSO) }}&sort=new&limit=20",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "nexum-flow/1.0"
            }
          ]
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "d1d2d3d4-1305-1305-1305-000000000004",
      "name": "Consolider les mentions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const depuis = Date.now() - 2 * 24 * 60 * 60 * 1000;\nconst items = [];\nconst hn = $('Mentions Hacker News').first().json;\nfor (const h of (hn.hits || [])) {\n  if (new Date(h.created_at).getTime() < depuis) continue;\n  items.push({ json: {\n    source: 'hackernews', external_id: String(h.objectID),\n    titre: (h.title || h.story_title || h.comment_text || '').substring(0, 490),\n    url: h.url || `https://news.ycombinator.com/item?id=${h.objectID}`\n  } });\n}\nconst rd = $('Mentions Reddit').first().json;\nfor (const c of (((rd.data || {}).children) || [])) {\n  const d = c.data || {};\n  if ((d.created_utc || 0) * 1000 < depuis) continue;\n  items.push({ json: {\n    source: 'reddit', external_id: String(d.id),\n    titre: (d.title || '').substring(0, 490),\n    url: 'https://www.reddit.com' + (d.permalink || '')\n  } });\n}\nreturn items;"
      }
    },
    {
      "id": "d1d2d3d4-1305-1305-1305-000000000005",
      "name": "Déduplication en base",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO mentions_marque (source, external_id, titre, url)\nVALUES ($1, $2, $3, $4)\nON CONFLICT (source, external_id) DO NOTHING\nRETURNING source, titre, url",
        "options": {
          "queryReplacement": "={{ [$json.source, $json.external_id, $json.titre, $json.url] }}"
        }
      }
    },
    {
      "id": "d1d2d3d4-1305-1305-1305-000000000006",
      "name": "Regrouper les nouveautés",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const nouvelles = $input.all().map(i => i.json).filter(j => j.titre);\nif (!nouvelles.length) return [];\nreturn [{ json: {\n  lignes: nouvelles.map(m => `- [${m.source}] ${m.titre}\\n  ${m.url}`).join('\\n'),\n  nb: nouvelles.length\n} }];"
      }
    },
    {
      "id": "d1d2d3d4-1305-1305-1305-000000000007",
      "name": "Trier par pertinence (IA)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1750,
        300
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "mistral-large-latest"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu surveilles la réputation en ligne d'une marque/personne. On te donne des mentions récentes (Hacker News, Reddit). Certaines peuvent être des homonymes ou du bruit. Classe-les : mentions probablement pertinentes (à lire) vs bruit probable, et signale tout ce qui ressemble à une critique ou un problème à traiter en priorité. Réponds en texte brut avec des tirets, en gardant les URLs."
            },
            {
              "role": "user",
              "content": "Marque surveillée : {{ $env.MARQUE_PERSO }}\nMentions ({{ $json.nb }}) :\n{{ $json.lignes }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 700
        }
      }
    },
    {
      "id": "d1d2d3d4-1305-1305-1305-000000000008",
      "name": "Alerter sur Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_GUILD_ID }}"
        },
        "sendTo": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_VEILLE_CHANNEL_ID }}"
        },
        "content": "🔎 **{{ $('Regrouper les nouveautés').item.json.nb }} nouvelle(s) mention(s) de {{ $env.MARQUE_PERSO }}**\n{{ $json.message.content }}",
        "options": {}
      }
    }
  ],
  "connections": {

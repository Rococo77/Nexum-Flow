{
  "name": "13.4 – Portfolio auto-alimenté",
  "nodes": [
    {
      "id": "d1d2d3d4-1304-1304-1304-000000000001",
      "name": "Webhook Projet livré",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "portfolio",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1304-1304-1304-000000000002",
      "name": "Valider le projet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $input.item.json.body || $input.item.json;\nconst titre = String(b.titre_projet || '').trim().substring(0, 255);\nconst description = String(b.description || '').trim().substring(0, 3000);\nif (!titre || !description) throw new Error('titre_projet et description requis');\nreturn {\n  titre_projet: titre,\n  client: String(b.client || 'confidentiel').substring(0, 255),\n  description,\n  stack: String(b.stack || '').substring(0, 500),\n  resultats: String(b.resultats || '').substring(0, 1000)\n};"
      }
    },
    {
      "id": "d1d2d3d4-1304-1304-1304-000000000003",
      "name": "Rédiger la fiche portfolio (IA)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        750,
        300
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "mistral-large-latest"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es rédacteur pour le portfolio d'une agence web. À partir des informations d'un projet livré, retourne UNIQUEMENT un JSON valide :\n{\n  \"titre\": \"titre accrocheur du cas client\",\n  \"accroche\": \"1 phrase de résumé\",\n  \"probleme\": \"paragraphe : le besoin initial du client\",\n  \"solution\": \"paragraphe : ce qui a été mis en place\",\n  \"resultats\": \"paragraphe : bénéfices concrets, chiffres si fournis\",\n  \"slug\": \"slug-url-du-cas\",\n  \"mots_cles\": [\"3 à 5 mots-clés\"]\n}\nN'invente pas de chiffres : utilise uniquement ceux fournis."
            },
            {
              "role": "user",
              "content": "Projet : {{ $json.titre_projet }}\nClient : {{ $json.client }}\nDescription : {{ $json.description }}\nStack : {{ $json.stack }}\nRésultats : {{ $json.resultats }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 1200
        }
      }
    },
    {
      "id": "d1d2d3d4-1304-1304-1304-000000000004",
      "name": "Parser la fiche",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const content = $input.item.json.message.content;\nlet fiche;\ntry {\n  fiche = JSON.parse(content.match(/\\{[\\s\\S]*\\}/)[0]);\n} catch(e) {\n  const p = $('Valider le projet').item.json;\n  fiche = { titre: p.titre_projet, accroche: '', probleme: p.description,\n            solution: '', resultats: p.resultats, slug: 'projet-' + Date.now(), mots_cles: [] };\n}\nconst html = `<p><em>${fiche.accroche}</em></p>` +\n  `<h3>Le besoin</h3><p>${fiche.probleme}</p>` +\n  `<h3>Notre solution</h3><p>${fiche.solution}</p>` +\n  `<h3>Les résultats</h3><p>${fiche.resultats}</p>`;\nreturn { ...fiche, contenu_html: html,\n  projet_description: $('Valider le projet').item.json.description };"
      }
    },
    {
      "id": "d1d2d3d4-1304-1304-1304-000000000005",
      "name": "Brouillon WordPress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WORDPRESS_URL }}/wp-json/wp/v2/posts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "title",
              "value": "={{ $json.titre }}"
            },
            {
              "name": "content",
              "value": "={{ $json.contenu_html }}"
            },
            {
              "name": "slug",
              "value": "={{ $json.slug }}"
            },
            {
              "name": "status",
              "value": "draft"
            }
          ]
        }
      }
    },
    {
      "id": "d1d2d3d4-1304-1304-1304-000000000006",
      "name": "Archiver la fiche",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "articles_seo"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "titre": "={{ $('Parser la fiche').item.json.titre }}",
            "contenu": "={{ $('Parser la fiche').item.json.contenu_html }}",
            "projet_description": "={{ $('Parser la fiche').item.json.projet_description }}",
            "statut": "portfolio",
            "cms_id": "={{ String($json.id || \"\") }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": true,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1304-1304-1304-000000000007",
      "name": "Notifier le marketing",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1750,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_GUILD_ID }}"
        },
        "sendTo": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_MARKETING_CHANNEL_ID }}"
        },
        "content": "🎨 **Nouvelle fiche portfolio en brouillon** : {{ $('Parser la fiche').item.json.titre }}\nRelisez et publiez depuis WordPress.",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1304-1304-1304-000000000008",
      "name": "Réponse webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2000,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, titre: $('Parser la fiche').item.json.titre, slug: $('Parser la fiche').item.json.slug }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {

    },
    "Enregistrer la date": {
      "main": [
        [
          {
            "node": "Réponse webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tous les jours 8h": {
      "main": [
        [
          {
            "node": "Échéances à J-30 / J-7 / J",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Échéances à J-30 / J-7 / J": {
      "main": [
        [
          {
            "node": "Y a-t-il des rappels ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Y a-t-il des rappels ?": {
      "main": [
        [
          {

{
  "name": "14.2 – Restaurant : réservations & rappel J-1",
  "nodes": [
    {
      "id": "d1d2d3d4-1402-1402-1402-000000000001",
      "name": "Webhook Réservation",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "reservation",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1402-1402-1402-000000000002",
      "name": "Valider la réservation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $input.item.json.body || $input.item.json;\nconst nom = String(b.nom || '').trim().substring(0, 255);\nconst email = String(b.email || '').trim().toLowerCase();\nconst date = String(b.date || '').trim();\nconst heure = String(b.heure || '').trim();\nif (!nom) throw new Error('nom requis');\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) throw new Error('email invalide');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date)) throw new Error('date au format YYYY-MM-DD requise');\nif (!/^\\d{2}:\\d{2}$/.test(heure)) throw new Error('heure au format HH:MM requise');\nif (new Date(date + 'T' + heure) < new Date()) throw new Error('la date est passée');\nconst couverts = Math.min(Math.max(parseInt(b.couverts, 10) || 2, 1), 30);\nreturn { nom, email, telephone: String(b.telephone || '').substring(0, 50),\n         date, heure, couverts,\n         commentaire: String(b.commentaire || '').substring(0, 500) };"
      }
    },
    {
      "id": "d1d2d3d4-1402-1402-1402-000000000003",
      "name": "Enregistrer la réservation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        750,
        300
      ],
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "reservations_resto"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "nom": "={{ $json.nom }}",
            "email": "={{ $json.email }}",
            "telephone": "={{ $json.telephone }}",
            "date": "={{ $json.date }}",
            "heure": "={{ $json.heure }}",
            "couverts": "={{ $json.couverts }}",
            "commentaire": "={{ $json.commentaire }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": true,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1402-1402-1402-000000000004",
      "name": "Email de confirmation",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $('Valider la réservation').item.json.email }}",
        "subject": "✅ Réservation confirmée le {{ $('Valider la réservation').item.json.date }} à {{ $('Valider la réservation').item.json.heure }}",
        "emailType": "html",
        "message": "<html><body><p>Bonjour {{ $(\"Valider la réservation\").item.json.nom }},</p><p>Votre table pour <strong>{{ $(\"Valider la réservation\").item.json.couverts }} personne(s)</strong> est confirmée le <strong>{{ $(\"Valider la réservation\").item.json.date }} à {{ $(\"Valider la réservation\").item.json.heure }}</strong>.</p><p>Un empêchement ? Répondez simplement à cet email.</p><p>À bientôt !</p></body></html>"
      }
    },
    {
      "id": "d1d2d3d4-1402-1402-1402-000000000005",
      "name": "Réponse webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, date: $('Valider la réservation').item.json.date, heure: $('Valider la réservation').item.json.heure }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "d1d2d3d4-1402-1402-1402-000000000006",
      "name": "Attendre la veille 18h",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{ new Date(new Date($('Valider la réservation').item.json.date + 'T18:00:00').getTime() - 24 * 60 * 60 * 1000).toISOString() }}"
      }
    },
    {
      "id": "d1d2d3d4-1402-1402-1402-000000000007",
      "name": "Toujours confirmée ?",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1750,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*)::int AS active FROM reservations_resto\nWHERE email = $1 AND date = $2::date AND heure = $3 AND statut = 'confirmee'",
        "options": {
          "queryReplacement": "={{ [$('Valider la réservation').item.json.email, $('Valider la réservation').item.json.date, $('Valider la réservation').item.json.heure] }}"
        }
      }
    },
    {
      "id": "d1d2d3d4-1402-1402-1402-000000000008",
      "name": "Envoyer le rappel ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-0008",
              "leftValue": "={{ $json.active }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "larger"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "d1d2d3d4-1402-1402-1402-000000000009",
      "name": "Email de rappel J-1",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        2250,
        200
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $('Valider la réservation').item.json.email }}",
        "subject": "🍽️ On vous attend demain !",
        "emailType": "html",
        "message": "<html><body><p>Bonjour {{ $(\"Valider la réservation\").item.json.nom }},</p><p>Petit rappel : votre table pour {{ $(\"Valider la réservation\").item.json.couverts }} est réservée <strong>demain à {{ $(\"Valider la réservation\").item.json.heure }}</strong>.</p><p>Un empêchement ? Répondez à cet email pour annuler ou déplacer.</p><p>À demain !</p></body></html>"
      }
    }
  ],
  "connections": {
    "Webhook Réservation": {
      "main": [
        [
          {
            "node": "Valider la réservation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valider la réservation": {
      "main": [
        [
          {

{
  "name": "14.5 – Association : dons, reçus & cotisations",
  "nodes": [
    {
      "id": "d1d2d3d4-1405-1405-1405-000000000001",
      "name": "Webhook Don / Cotisation",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        150
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "don",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1405-1405-1405-000000000002",
      "name": "Valider le versement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        150
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $input.item.json.body || $input.item.json;\nconst email = String(b.email || '').trim().toLowerCase();\nconst montant = Number(b.montant);\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) throw new Error('email invalide');\nif (isNaN(montant) || montant <= 0) throw new Error('montant invalide');\nconst type = b.type === 'cotisation' ? 'cotisation' : 'don';\nreturn {\n  nom: String(b.nom || '').trim().substring(0, 255),\n  email,\n  montant: Math.round(montant * 100) / 100,\n  type,\n  recu_le: new Date().toISOString().split('T')[0]\n};"
      }
    },
    {
      "id": "d1d2d3d4-1405-1405-1405-000000000003",
      "name": "Enregistrer le versement",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        750,
        150
      ],
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "dons_recus"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "nom": "={{ $json.nom }}",
            "email": "={{ $json.email }}",
            "montant": "={{ $json.montant }}",
            "type": "={{ $json.type }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": true,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1405-1405-1405-000000000004",
      "name": "Mettre à jour le membre",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1000,
        150
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO membres_asso (nom, email, date_fin_adhesion)\nVALUES ($1, $2, CASE WHEN $3 = 'cotisation' THEN CURRENT_DATE + INTERVAL '1 year' ELSE NULL END)\nON CONFLICT (email) DO UPDATE SET\n  nom = EXCLUDED.nom,\n  date_fin_adhesion = CASE WHEN $3 = 'cotisation'\n    THEN GREATEST(COALESCE(membres_asso.date_fin_adhesion, CURRENT_DATE), CURRENT_DATE) + INTERVAL '1 year'\n    ELSE membres_asso.date_fin_adhesion END\nRETURNING email, date_fin_adhesion",
        "options": {
          "queryReplacement": "={{ [$('Valider le versement').item.json.nom, $('Valider le versement').item.json.email, $('Valider le versement').item.json.type] }}"
        }
      }
    },
    {
      "id": "d1d2d3d4-1405-1405-1405-000000000005",
      "name": "Générer le reçu PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        150
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.API_HOST }}/api/v1/documents/markdown-to-pdf",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "=# Reçu – {{ $('Valider le versement').item.json.type }}\n\n**{{ $env.ASSO_NOM }}** atteste avoir reçu de **{{ $('Valider le versement').item.json.nom }}** la somme de **{{ $('Valider le versement').item.json.montant }} €** le {{ $('Valider le versement').item.json.recu_le }} au titre de : {{ $('Valider le versement').item.json.type }}.\n\nCe versement ouvre droit à réduction d'impôt dans les conditions des articles 200 et 238 bis du CGI (si l'association y est éligible).\n\nFait le {{ $('Valider le versement').item.json.recu_le }}."
            },
            {
              "name": "titre",
              "value": "recu-versement"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      }
    },
    {
      "id": "d1d2d3d4-1405-1405-1405-000000000006",
      "name": "Email de remerciement",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1500,
        150
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $('Valider le versement').item.json.email }}",
        "subject": "Merci pour votre {{ $('Valider le versement').item.json.type }} ! 💛",
        "emailType": "html",
        "message": "<html><body><p>Bonjour {{ $(\"Valider le versement\").item.json.nom }},</p><p>Un grand merci pour votre {{ $(\"Valider le versement\").item.json.type }} de <strong>{{ $(\"Valider le versement\").item.json.montant }} €</strong>. Votre reçu est en pièce jointe.</p><p>Grâce à vous, {{ $env.ASSO_NOM }} peut poursuivre ses actions.</p><p>Avec toute notre gratitude,<br>{{ $env.ASSO_NOM }}</p></body></html>",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "data"
              }
            ]
          }
        }
      }
    },
    {
      "id": "d1d2d3d4-1405-1405-1405-000000000007",
      "name": "Réponse webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1750,
        150
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, montant: $('Valider le versement').item.json.montant }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "d1d2d3d4-1405-1405-1405-000000000008",
      "name": "Le 1er du mois à 9h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        500
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 1 * *"
            }
          ]
        }
      }
    },
    {
      "id": "d1d2d3d4-1405-1405-1405-000000000009",
      "name": "Adhésions expirées ou expirant",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        500
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT nom, email, date_fin_adhesion::date AS fin\nFROM membres_asso\nWHERE date_fin_adhesion IS NOT NULL\n  AND date_fin_adhesion < CURRENT_DATE + INTERVAL '1 month'\n  AND (derniere_relance IS NULL OR derniere_relance < CURRENT_DATE - INTERVAL '25 days')\nORDER BY date_fin_adhesion",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1405-1405-1405-000000000010",
      "name": "Relance cotisation",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        750,
        500
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "{{ $env.ASSO_NOM }} – votre adhésion arrive à échéance",
        "emailType": "html",
        "message": "<html><body><p>Bonjour {{ $json.nom }},</p><p>Votre adhésion à <strong>{{ $env.ASSO_NOM }}</strong> {{ new Date($json.fin) < new Date() ? \"a expiré le\" : \"expire le\" }} {{ $json.fin }}.</p><p>Pour continuer à soutenir nos actions (et recevoir votre reçu fiscal), vous pouvez renouveler dès maintenant — répondez à cet email ou rendez-vous sur notre page d'adhésion.</p><p>Merci pour votre fidélité !<br>{{ $env.ASSO_NOM }}</p></body></html>"
      }
    },
    {
      "id": "d1d2d3d4-1405-1405-1405-000000000011",
      "name": "Noter la relance",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1000,
        500
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE membres_asso SET derniere_relance = CURRENT_DATE WHERE email = $1",
        "options": {
          "queryReplacement": "={{ [$('Adhésions expirées ou expirant').item.json.email] }}"
        }
      }
    }
  ],

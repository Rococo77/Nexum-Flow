{
  "name": "10.15 – Rappels de dates importantes",
  "nodes": [
    {
      "id": "d1d2d3d4-1015-1015-1015-000000000001",
      "name": "Webhook Date importante",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        150
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "date-importante",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1015-1015-1015-000000000002",
      "name": "Valider la date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        150
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $input.item.json.body || $input.item.json;\nconst libelle = String(b.libelle || '').trim().substring(0, 255);\nconst dateCible = String(b.date || '').trim();\nif (!libelle) throw new Error('libelle requis');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(dateCible)) throw new Error('date requise au format YYYY-MM-DD');\nconst types = ['anniversaire', 'renouvellement', 'administratif', 'autre'];\nconst recurrences = ['annuelle', 'unique'];\nreturn {\n  libelle,\n  date_cible: dateCible,\n  type: types.includes(b.type) ? b.type : 'autre',\n  recurrence: recurrences.includes(b.recurrence) ? b.recurrence : 'annuelle'\n};"
      }
    },
    {
      "id": "d1d2d3d4-1015-1015-1015-000000000003",
      "name": "Enregistrer la date",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        750,
        150
      ],
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "dates_importantes"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "libelle": "={{ $json.libelle }}",
            "date_cible": "={{ $json.date_cible }}",
            "type": "={{ $json.type }}",
            "recurrence": "={{ $json.recurrence }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": true,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1015-1015-1015-000000000004",
      "name": "Réponse webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1000,
        150
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, libelle: $('Valider la date').item.json.libelle }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "d1d2d3d4-1015-1015-1015-000000000005",
      "name": "Tous les jours 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        450
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "d1d2d3d4-1015-1015-1015-000000000006",
      "name": "Échéances à J-30 / J-7 / J",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        450
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH prochaines AS (\n  SELECT id, libelle, type, recurrence, date_cible,\n    CASE WHEN recurrence = 'unique' THEN date_cible\n    ELSE (\n      make_date(EXTRACT(YEAR FROM CURRENT_DATE)::int,\n                EXTRACT(MONTH FROM date_cible)::int,\n                LEAST(EXTRACT(DAY FROM date_cible)::int, 28))\n      + CASE WHEN make_date(EXTRACT(YEAR FROM CURRENT_DATE)::int,\n                            EXTRACT(MONTH FROM date_cible)::int,\n                            LEAST(EXTRACT(DAY FROM date_cible)::int, 28)) < CURRENT_DATE\n             THEN INTERVAL '1 year' ELSE INTERVAL '0 days' END\n    )::date END AS prochaine\n  FROM dates_importantes WHERE actif = TRUE\n)\nSELECT *, (prochaine - CURRENT_DATE)::int AS dans_jours\nFROM prochaines\nWHERE (prochaine - CURRENT_DATE) IN (0, 7, 30)\nORDER BY prochaine",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-1015-1015-1015-000000000007",
      "name": "Y a-t-il des rappels ?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        450
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json).filter(j => j.libelle);\nif (!items.length) return [];\nconst lignes = items.map(j => {\n  const quand = j.dans_jours === 0 ? \"aujourd'hui\" : `dans ${j.dans_jours} jours`;\n  return `<li><strong>${j.libelle}</strong> (${j.type}) – ${quand}</li>`;\n});\nreturn [{ json: { html: `<ul>${lignes.join('')}</ul>`, nb: items.length } }];"
      }
    },
    {
      "id": "d1d2d3d4-1015-1015-1015-000000000008",
      "name": "Email de rappel",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1000,
        450
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $env.EMAIL_PERSO }}",
        "subject": "📅 {{ $json.nb }} date(s) importante(s) à venir",
        "emailType": "html",
        "message": "<html><body><h2>📅 Rappels</h2>{{ $json.html }}<p>Pensez à préparer ce qu'il faut (cadeau, papiers, renouvellement…).</p></body></html>"
      }
    }
  ],
  "connections": {
    "Webhook Date importante": {
      "main": [
        [

{
  "name": "3.4 – Onboarding client complet",
  "nodes": [
    {
      "id": "d1d2d3d4-0304-0304-0304-000000000001",
      "name": "Webhook Onboarding",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "onboarding-client",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-0304-0304-0304-000000000002",
      "name": "Valider le client",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $input.item.json.body || $input.item.json;\nconst clientId = String(b.client_id || '').trim();\nif (!/^[0-9a-f-]{36}$/i.test(clientId)) throw new Error('client_id (UUID) requis');\nreturn { client_id: clientId,\n         projet: String(b.projet || 'Nouveau projet').substring(0, 255) };"
      }
    },
    {
      "id": "d1d2d3d4-0304-0304-0304-000000000003",
      "name": "Charger le client",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        710,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id, c.nom, c.prenom, c.email, c.entreprise,\n  (SELECT d.montant_ttc FROM devis d WHERE d.client_id = c.id AND d.statut = 'accepte'\n     ORDER BY d.created_at DESC LIMIT 1)::float AS montant_devis\nFROM clients c WHERE c.id = $1::uuid",
        "options": {
          "queryReplacement": "={{ [$json.client_id] }}"
        }
      }
    },
    {
      "id": "d1d2d3d4-0304-0304-0304-000000000004",
      "name": "Créer le dossier de stockage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.API_HOST }}/api/v1/storage/dossier",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chemin",
              "value": "={{ 'Clients/' + ($json.entreprise || $json.nom).replace(/[^a-zA-Z0-9À-ÿ_\\- ]/g, '_').substring(0, 100) }}"
            },
            {
              "name": "client_id",
              "value": "={{ $json.id }}"
            }
          ]
        }
      }
    },
    {
      "id": "d1d2d3d4-0304-0304-0304-000000000005",
      "name": "Générer le contrat (IA)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1170,
        300
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "mistral-large-latest"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es juriste en droit français des affaires. Rédige un contrat de prestation de services web complet et professionnel en markdown : parties, objet, durée, prix, modalités de paiement (30% acompte / 70% livraison), propriété intellectuelle, confidentialité, responsabilité, résiliation, droit applicable. Laisse des champs [À COMPLÉTER] pour les mentions légales manquantes."
            },
            {
              "role": "user",
              "content": "Prestataire : Nexum Flow\nClient : {{ $('Charger le client').item.json.entreprise }} ({{ $('Charger le client').item.json.prenom }} {{ $('Charger le client').item.json.nom }})\nProjet : {{ $('Valider le client').item.json.projet }}\nMontant TTC : {{ $('Charger le client').item.json.montant_devis ?? '[À COMPLÉTER]' }} €"
            }
          ]
        },
        "options": {
          "temperature": 0.2,
          "maxTokens": 2500
        }
      }
    },
    {
      "id": "d1d2d3d4-0304-0304-0304-000000000006",
      "name": "Contrat en PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.API_HOST }}/api/v1/documents/markdown-to-pdf",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.message.content }}"
            },
            {
              "name": "titre",
              "value": "contrat"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      }
    },
    {
      "id": "d1d2d3d4-0304-0304-0304-000000000007",
      "name": "Email de bienvenue + contrat",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1630,
        300
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $('Charger le client').item.json.email }}",
        "subject": "🚀 Bienvenue ! Lançons votre projet",
        "emailType": "html",
        "message": "<html><body><p>Bonjour {{ $(\"Charger le client\").item.json.prenom }},</p><p>Bienvenue chez Nexum Flow ! Nous sommes ravis de démarrer <strong>{{ $(\"Valider le client\").item.json.projet }}</strong> avec vous.</p><p>Vous trouverez en pièce jointe votre projet de contrat à relire. Pour planifier le rendez-vous de lancement, répondez à cet email avec vos disponibilités cette semaine.</p><p>À très vite,<br>L'équipe Nexum Flow</p></body></html>",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "data"
              }
            ]
          }
        }
      }
    },
    {
      "id": "d1d2d3d4-0304-0304-0304-000000000008",
      "name": "Créer le canal Discord projet",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1860,
        300
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "channel",
        "operation": "create",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_GUILD_ID }}"
        },
        "name": "={{ 'projet-' + ($('Charger le client').item.json.entreprise || $('Charger le client').item.json.nom).toLowerCase().replace(/[^a-z0-9]+/g, '-').substring(0, 80) }}",
        "type": "0",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-0304-0304-0304-000000000009",
      "name": "Annoncer le lancement",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        2090,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_GUILD_ID }}"
        },
        "sendTo": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_PROJETS_CHANNEL_ID }}"
        },
        "content": "🚀 **Nouveau projet lancé !**\n**Client :** {{ $('Charger le client').item.json.entreprise }} ({{ $('Charger le client').item.json.prenom }} {{ $('Charger le client').item.json.nom }})\n**Projet :** {{ $('Valider le client').item.json.projet }}\n✅ Dossier de stockage créé\n✅ Contrat envoyé pour relecture\n✅ Canal projet : {{ $('Créer le canal Discord projet').item.json.name || 'à créer manuellement' }}",
        "options": {}
      }
    },
    {
      "id": "d1d2d3d4-0304-0304-0304-000000000010",
      "name": "Réponse webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2320,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, client: $('Charger le client').item.json.entreprise, etapes: ['dossier', 'contrat', 'email', 'discord'] }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook Onboarding": {
      "main": [
        [
          {
            "node": "Valider le client",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valider le client": {
      "main": [
        [
          {
            "node": "Charger le client",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Charger le client": {
      "main": [
        [
          {
            "node": "Créer le dossier de stockage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Créer le dossier de stockage": {
      "main": [
        [
          {
            "node": "Générer le contrat (IA)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Générer le contrat (IA)": {
      "main": [
        [
          {
            "node": "Contrat en PDF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Contrat en PDF": {
      "main": [
        [
          {
            "node": "Email de bienvenue + contrat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email de bienvenue + contrat": {
      "main": [
        [
          {
            "node": "Créer le canal Discord projet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Créer le canal Discord projet": {
      "main": [
        [
          {
            "node": "Annoncer le lancement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Annoncer le lancement": {
      "main": [
        [
          {
            "node": "Réponse webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "d1d2d3d4-0304-0304-0304-000000000099",
  "meta": {
    "instanceId": "nexum-flow"
  },
  "tags": [
    {
      "id": "tag-client",
      "name": "client"
    },
    {
      "id": "tag-ia",
      "name": "ia"
    }
  ]
}

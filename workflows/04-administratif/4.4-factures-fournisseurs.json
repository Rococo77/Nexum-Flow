{
  "name": "4.4 – Factures fournisseurs (OCR + échéancier)",
  "nodes": [
    {
      "id": "c1c2c3c4-0044-0044-0044-000000000001",
      "name": "Webhook Facture fournisseur",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "facture-fournisseur",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "c1c2c3c4-0044-0044-0044-000000000002",
      "name": "Valider la demande",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $input.item.json.body || $input.item.json;\nconst url = String(b.image_url || '').trim();\nif (!/^https?:\\/\\//.test(url)) throw new Error('image_url manquante ou invalide');\nreturn {\n  image_url: url.substring(0, 500),\n  source: String(b.source || 'webhook').substring(0, 100)\n};"
      }
    },
    {
      "id": "c1c2c3c4-0044-0044-0044-000000000003",
      "name": "OCR de la facture",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.ocr.space/parse/image",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.OCR_SPACE_API_KEY || 'helloworld' }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.image_url }}"
            },
            {
              "name": "language",
              "value": "fre"
            },
            {
              "name": "OCREngine",
              "value": "2"
            },
            {
              "name": "scale",
              "value": "true"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "c1c2c3c4-0044-0044-0044-000000000004",
      "name": "Texte OCR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $input.item.json;\nif (r.IsErroredOnProcessing) throw new Error('OCR échoué : ' + (Array.isArray(r.ErrorMessage) ? r.ErrorMessage.join(' ') : r.ErrorMessage || 'erreur inconnue'));\nconst texte = (r.ParsedResults || []).map(p => p.ParsedText || '').join('\\n').replace(/\\r/g, '').trim();\nif (!texte) throw new Error('Aucun texte détecté sur la facture');\nreturn {\n  texte: texte.substring(0, 6000),\n  image_url: $('Valider la demande').item.json.image_url\n};"
      }
    },
    {
      "id": "c1c2c3c4-0044-0044-0044-000000000005",
      "name": "Extraire les données (IA)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "mistral-large-latest"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es un assistant comptable. À partir du texte OCR d'une facture fournisseur, retourne UNIQUEMENT un JSON valide avec ces champs :\n- fournisseur: string\n- numero_facture: string\n- date_facture: 'YYYY-MM-DD' ou null\n- date_echeance: 'YYYY-MM-DD' ou null\n- montant_ht: number ou null\n- montant_tva: number ou null\n- montant_ttc: number ou null\n- devise: 'EUR' | 'USD' | autre code ISO\n- categorie: 'abonnement' | 'prestataire' | 'materiel' | 'telecom' | 'autre'\nN'invente aucune valeur : mets null si l'information est absente."
            },
            {
              "role": "user",
              "content": "Texte OCR de la facture :\n{{ $json.texte }}"
            }
          ]
        },
        "options": {
          "temperature": 0.1,
          "maxTokens": 800
        }
      }
    },
    {
      "id": "c1c2c3c4-0044-0044-0044-000000000006",
      "name": "Parser extraction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const content = $input.item.json.message.content;\nlet f;\ntry {\n  const match = content.match(/\\{[\\s\\S]*\\}/);\n  f = JSON.parse(match[0]);\n} catch(e) {\n  f = { fournisseur: 'Inconnu', numero_facture: null, date_facture: null,\n        date_echeance: null, montant_ht: null, montant_tva: null,\n        montant_ttc: null, devise: 'EUR', categorie: 'autre' };\n}\nconst src = $('Texte OCR').item.json;\nreturn {\n  fournisseur: String(f.fournisseur || 'Inconnu').substring(0, 255),\n  numero_facture: f.numero_facture ? String(f.numero_facture).substring(0, 100) : null,\n  date_facture: f.date_facture || null,\n  date_echeance: f.date_echeance || null,\n  montant_ht: f.montant_ht ?? null,\n  montant_tva: f.montant_tva ?? null,\n  montant_ttc: f.montant_ttc ?? null,\n  devise: String(f.devise || 'EUR').substring(0, 10),\n  categorie: String(f.categorie || 'autre').substring(0, 50),\n  image_url: src.image_url,\n  texte_ocr: src.texte\n};"
      }
    },
    {
      "id": "c1c2c3c4-0044-0044-0044-000000000007",
      "name": "Enregistrer la facture",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1750,
        300
      ],
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "factures_fournisseurs"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fournisseur": "={{ $json.fournisseur }}",
            "numero_facture": "={{ $json.numero_facture }}",
            "date_facture": "={{ $json.date_facture }}",
            "date_echeance": "={{ $json.date_echeance }}",
            "montant_ht": "={{ $json.montant_ht }}",
            "montant_tva": "={{ $json.montant_tva }}",
            "montant_ttc": "={{ $json.montant_ttc }}",
            "devise": "={{ $json.devise }}",
            "categorie": "={{ $json.categorie }}",
            "image_url": "={{ $json.image_url }}",
            "texte_ocr": "={{ $json.texte_ocr }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": true,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "c1c2c3c4-0044-0044-0044-000000000008",
      "name": "Notifier la compta",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_GUILD_ID }}"
        },
        "sendTo": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.DISCORD_ADMIN_CHANNEL_ID }}"
        },
        "content": "🧾 **Nouvelle facture fournisseur**\n**Fournisseur :** {{ $('Parser extraction').item.json.fournisseur }}\n**N° :** {{ $('Parser extraction').item.json.numero_facture || '–' }}\n**Montant TTC :** {{ $('Parser extraction').item.json.montant_ttc ?? '–' }} {{ $('Parser extraction').item.json.devise }}\n**Échéance :** {{ $('Parser extraction').item.json.date_echeance || 'non détectée' }}\n**Catégorie :** {{ $('Parser extraction').item.json.categorie }}",
        "options": {}
      }
    },
    {
      "id": "c1c2c3c4-0044-0044-0044-000000000009",
      "name": "Réponse webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2250,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, fournisseur: $('Parser extraction').item.json.fournisseur, montant_ttc: $('Parser extraction').item.json.montant_ttc, date_echeance: $('Parser extraction').item.json.date_echeance }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {

            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email de confirmation": {
      "main": [
        [
          {
            "node": "Réponse webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Réponse webhook": {
      "main": [
        [
          {
            "node": "Attendre la veille 18h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Attendre la veille 18h": {
      "main": [
        [
          {
            "node": "Toujours confirmée ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Toujours confirmée ?": {
      "main": [
        [
          {
            "node": "Envoyer le rappel ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Envoyer le rappel ?": {
      "main": [
        [
          {
            "node": "Email de rappel J-1",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
